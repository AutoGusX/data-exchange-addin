<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FusionDxHelper</AssemblyName>
    <RootNamespace>FusionDxHelper.Api</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FusionDxHelper.Core\FusionDxHelper.Core.csproj" />
    <ProjectReference Include="..\FusionDxHelper.AutodeskSdk\FusionDxHelper.AutodeskSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FusionDxHelper.Tests" />
    <!-- Referenced here too so the package build targets deploy the SDK service host (DataExchangeServices, ~650 MB) next to the helper. -->
    <PackageReference Include="Autodesk.DataExchange" Version="8.1.0" />
    <None Include="..\..\..\tests\fixtures\*.step" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
